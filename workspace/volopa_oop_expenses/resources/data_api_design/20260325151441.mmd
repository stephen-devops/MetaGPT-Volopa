%%{init: {'theme': 'default', 'themeVariables': { 'fontFamily': 'Inter' }}}%%

classDiagram
    class UserFeaturePermission {
        +int id
        +int user_id
        +int client_id
        +int feature_id
        +int grantor_id
        +int manager_user_id
        +bool is_enabled
        +datetime created_at
        +datetime updated_at
        +user() BelongsTo
        +client() BelongsTo
        +grantor() BelongsTo
        +manager() BelongsTo
    }
    
    class OptPocketExpenseType {
        +int id
        +string option
        +enum amount_sign
        +expenses() HasMany
    }
    
    class PocketExpenseSourceClientConfig {
        +int id
        +string uuid
        +int client_id
        +string name
        +bool is_default
        +bool deleted
        +datetime delete_time
        +datetime create_time
        +datetime update_time
        +client() BelongsTo
        +metadata() HasMany
    }
    
    class PocketExpense {
        +int id
        +string uuid
        +int user_id
        +int client_id
        +date date
        +string merchant_name
        +string merchant_description
        +int expense_type
        +string currency
        +decimal amount
        +string merchant_address
        +decimal vat_amount
        +text notes
        +enum status
        +int created_by_user_id
        +int updated_by_user_id
        +int approved_by_user_id
        +datetime create_time
        +datetime update_time
        +bool deleted
        +datetime delete_time
        +user() BelongsTo
        +client() BelongsTo
        +expenseType() BelongsTo
        +createdBy() BelongsTo
        +metadata() HasMany
    }
    
    class PocketExpenseMetadata {
        +int id
        +int pocket_expense_id
        +enum metadata_type
        +int transaction_category_id
        +int tracking_code_id
        +int project_id
        +int file_store_id
        +int expense_source_id
        +int additional_field_id
        +int user_id
        +json details_json
        +datetime create_time
        +datetime update_time
        +bool deleted
        +datetime delete_time
        +expense() BelongsTo
        +category() BelongsTo
        +trackingCode() BelongsTo
        +project() BelongsTo
        +file() BelongsTo
        +source() BelongsTo
        +additionalField() BelongsTo
        +user() BelongsTo
    }
    
    class PocketExpenseFileUpload {
        +int id
        +string uuid
        +int user_id
        +int client_id
        +int created_by_user_id
        +string file_name
        +string file_path
        +int total_records
        +int valid_records
        +json validation_errors
        +enum status
        +datetime uploaded_at
        +datetime validated_at
        +datetime processed_at
        +datetime created_at
        +datetime updated_at
        +datetime deleted_at
        +user() BelongsTo
        +client() BelongsTo
        +createdBy() BelongsTo
        +uploadsData() HasMany
    }
    
    class PocketExpenseUploadsData {
        +int id
        +int upload_id
        +int line_number
        +enum status
        +json expense_data
        +datetime created_at
        +datetime updated_at
        +upload() BelongsTo
    }
    
    class UserPermissionService {
        +grantPermission(int userId, int clientId, int featureId, int grantorId, int managerId) UserFeaturePermission
        +revokePermission(int userId, int clientId, int featureId) bool
        +checkPermission(int userId, int clientId, int featureId) bool
        +getUserManagedBy(int managerId, int clientId) Collection
    }
    
    class PocketExpenseService {
        +create(array data) PocketExpense
        +update(int id, array data) PocketExpense
        +delete(int id) bool
        +findById(int id) PocketExpense
        +getByUser(int userId, int clientId) Collection
    }
    
    class PocketExpenseFXService {
        +getWalletBaseCurrency(int clientId) array
        +getFXRate(string fromCurrency, string toCurrency, date date) float
        +calculateConversion(float amount, float rate, float commission) float
        +convertExpenseAmount(PocketExpense expense) array
    }
    
    class PocketExpenseCSVValidator {
        +validate(string filePath, int targetUserId, int clientId, int adminId) array
        +validateRow(array row, int lineNumber) array
        +preloadReferenceData(int clientId) void
        -validateHeaders(array headers) bool
        -validateExpenseType(string type) bool
        -validateCurrency(string currency) bool
        -validateAmount(string amount, string type) bool
        -validateDate(string date) bool
    }
    
    class ProcessExpenseUpload {
        +int uploadId
        +handle() void
        -syncExpensesToMainService(Collection expenses) void
        -updateUploadStatus(string status) void
        -notifyUser() void
    }
    
    class UserFeaturePermissionController {
        +index(Request request) JsonResponse
        +store(StoreUserFeaturePermissionRequest request) JsonResponse
        +show(int id) JsonResponse
        +update(UpdateUserFeaturePermissionRequest request, int id) JsonResponse
        +destroy(int id) JsonResponse
    }
    
    class PocketExpenseController {
        +index(Request request) JsonResponse
        +store(StorePocketExpenseRequest request) JsonResponse
        +show(int id) JsonResponse
        +update(UpdatePocketExpenseRequest request, int id) JsonResponse
        +destroy(int id) JsonResponse
    }
    
    class PocketExpenseUploadController {
        +uploadPocketExpenseCSV(UploadPocketExpenseCSVRequest request) JsonResponse
        +getUploadStatus(int uploadId) JsonResponse
    }
    
    UserFeaturePermission --> User
    UserFeaturePermission --> Client
    PocketExpense --> User
    PocketExpense --> Client
    PocketExpense --> OptPocketExpenseType
    PocketExpenseMetadata --> PocketExpense
    PocketExpenseFileUpload --> User
    PocketExpenseFileUpload --> Client
    PocketExpenseUploadsData --> PocketExpenseFileUpload
    UserFeaturePermissionController --> UserPermissionService
    PocketExpenseController --> PocketExpenseService
    PocketExpenseController --> PocketExpenseFXService
    PocketExpenseUploadController --> PocketExpenseCSVValidator
    ProcessExpenseUpload --> PocketExpenseService
