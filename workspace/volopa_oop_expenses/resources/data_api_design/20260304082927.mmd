%%{init: {'theme': 'default', 'themeVariables': { 'fontFamily': 'Inter' }}}%%

classDiagram
    class UserFeaturePermission {
        +int id
        +int user_id
        +int client_id
        +int feature_id
        +int grantor_id
        +int manager_user_id
        +bool is_enabled
        +timestamp created_at
        +timestamp updated_at
        +user() BelongsTo
        +client() BelongsTo
        +grantor() BelongsTo
        +manager() BelongsTo
    }
    
    class OptPocketExpenseType {
        +int id
        +string option
        +enum amount_sign
        +pocketExpenses() HasMany
    }
    
    class PocketExpenseSourceClientConfig {
        +int id
        +string uuid
        +int client_id
        +string name
        +bool is_default
        +bool deleted
        +datetime delete_time
        +datetime create_time
        +datetime update_time
        +client() BelongsTo
        +metadata() HasMany
    }
    
    class PocketExpense {
        +int id
        +string uuid
        +int user_id
        +int client_id
        +date date
        +string merchant_name
        +string merchant_description
        +int expense_type
        +string currency
        +decimal amount
        +string merchant_address
        +decimal vat_amount
        +text notes
        +enum status
        +int created_by_user_id
        +int updated_by_user_id
        +int approved_by_user_id
        +datetime create_time
        +datetime update_time
        +bool deleted
        +datetime delete_time
        +user() BelongsTo
        +client() BelongsTo
        +expenseType() BelongsTo
        +createdBy() BelongsTo
        +updatedBy() BelongsTo
        +approvedBy() BelongsTo
        +metadata() HasMany
    }
    
    class PocketExpenseMetadata {
        +int id
        +int pocket_expense_id
        +enum metadata_type
        +int transaction_category_id
        +int tracking_code_id
        +int project_id
        +int file_store_id
        +int expense_source_id
        +int additional_field_id
        +int user_id
        +json details_json
        +datetime create_time
        +datetime update_time
        +bool deleted
        +datetime delete_time
        +pocketExpense() BelongsTo
        +transactionCategory() BelongsTo
        +trackingCode() BelongsTo
        +project() BelongsTo
        +fileStore() BelongsTo
        +expenseSource() BelongsTo
        +additionalField() BelongsTo
        +user() BelongsTo
    }
    
    class PocketExpenseFileUpload {
        +int id
        +string uuid
        +int user_id
        +int client_id
        +int created_by_user_id
        +string file_name
        +string file_path
        +int total_records
        +int valid_records
        +json validation_errors
        +enum status
        +timestamp uploaded_at
        +timestamp validated_at
        +timestamp processed_at
        +timestamp created_at
        +timestamp updated_at
        +timestamp deleted_at
        +user() BelongsTo
        +client() BelongsTo
        +createdBy() BelongsTo
        +uploadsData() HasMany
    }
    
    class PocketExpenseUploadsData {
        +int id
        +int upload_id
        +int line_number
        +enum status
        +json expense_data
        +timestamp created_at
        +timestamp updated_at
        +upload() BelongsTo
    }
    
    class UserPermissionService {
        +grantPermission(int userId, int clientId, int featureId, int grantorId, int managerId) UserFeaturePermission
        +revokePermission(int permissionId, int revokerUserId) bool
        +checkPermission(int userId, int clientId, int featureId) bool
        +getManagedUsers(int managerId, int clientId) Collection
        +canManageUser(int managerId, int targetUserId, int clientId) bool
    }
    
    class PocketExpenseService {
        +createExpense(array data, int userId, int clientId) PocketExpense
        +updateExpense(PocketExpense expense, array data, int userId) PocketExpense
        +deleteExpense(PocketExpense expense, int userId) bool
        +getExpenses(int userId, int clientId, array filters) Collection
        +approveExpense(PocketExpense expense, int approverId) PocketExpense
        +attachMetadata(PocketExpense expense, string type, array data) PocketExpenseMetadata
    }
    
    class PocketExpenseCSVValidator {
        +validateCSV(string filePath, int targetUserId, int clientId, int adminId) array
        +validateHeaders(array headers) array
        +validateRow(array row, int lineNumber) array
        +preloadReferenceData(int clientId) void
        +validateExpenseType(string type) bool
        +validateCurrency(string currency) bool
        +validateSource(string source, int clientId) bool
    }
    
    class FXConversionService {
        +getBaseCurrency(int clientId) string
        +convertAmount(decimal amount, string fromCurrency, string toCurrency, date expenseDate) array
        +getFXRate(string fromCurrency, string toCurrency, date date) decimal
        +applyCommission(decimal rate, decimal commissionPercent) decimal
    }
    
    class ProcessExpenseUpload {
        +int uploadId
        +handle() void
        +syncExpensesBatch(Collection expenseData) void
        +updateUploadStatus(string status) void
        +notifyUser(int userId, string message) void
    }
    
    class UserFeaturePermissionController {
        +index(Request request) JsonResponse
        +store(GrantUserFeaturePermissionRequest request) JsonResponse
        +destroy(int id, RevokeUserFeaturePermissionRequest request) JsonResponse
    }
    
    class PocketExpenseController {
        +index(Request request) JsonResponse
        +store(StorePocketExpenseRequest request) JsonResponse
        +show(int id) JsonResponse
        +update(int id, UpdatePocketExpenseRequest request) JsonResponse
        +destroy(int id) JsonResponse
        +approve(int id, Request request) JsonResponse
        +convertFX(Request request) JsonResponse
    }
    
    class PocketExpenseUploadController {
        +uploadCSV(UploadPocketExpenseCSVRequest request) JsonResponse
        +getUploadStatus(int uploadId) JsonResponse
    }
    
    UserFeaturePermission ||--|| User : belongs_to
    UserFeaturePermission ||--|| Client : belongs_to
    PocketExpense ||--|| User : belongs_to
    PocketExpense ||--|| Client : belongs_to
    PocketExpense ||--|| OptPocketExpenseType : belongs_to
    PocketExpense ||--o{ PocketExpenseMetadata : has_many
    PocketExpenseMetadata ||--|| PocketExpense : belongs_to
    PocketExpenseMetadata ||--|| PocketExpenseSourceClientConfig : belongs_to
    PocketExpenseFileUpload ||--|| User : belongs_to
    PocketExpenseFileUpload ||--|| Client : belongs_to
    PocketExpenseFileUpload ||--o{ PocketExpenseUploadsData : has_many
    PocketExpenseUploadsData ||--|| PocketExpenseFileUpload : belongs_to
    UserFeaturePermissionController ..> UserPermissionService : uses
    PocketExpenseController ..> PocketExpenseService : uses
    PocketExpenseController ..> FXConversionService : uses
    PocketExpenseUploadController ..> PocketExpenseCSVValidator : uses
    PocketExpenseUploadController ..> ProcessExpenseUpload : dispatches
