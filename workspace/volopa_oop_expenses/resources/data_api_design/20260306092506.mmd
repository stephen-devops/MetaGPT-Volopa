    class PocketExpenseUploadsData {
        +id: bigint
        +upload_id: bigint
        +line_number: int
        +status: enum
        +expense_data: json
        +created_at: timestamp
        +updated_at: timestamp
        +upload() BelongsTo
    }
    class UserFeaturePermissionController {
        +index(Request): JsonResponse
        +store(StoreUserFeaturePermissionRequest): JsonResponse
        +show(int): JsonResponse
        +update(UpdateUserFeaturePermissionRequest, int): JsonResponse
        +destroy(int): JsonResponse
    }
    class PocketExpenseController {
        +index(Request): JsonResponse
        +store(StorePocketExpenseRequest): JsonResponse
        +show(int): JsonResponse
        +update(UpdatePocketExpenseRequest, int): JsonResponse
        +destroy(int): JsonResponse
        +convertCurrency(Request): JsonResponse
    }
    class PocketExpenseUploadController {
        +uploadPocketExpenseCSV(PocketExpenseUploadRequest): JsonResponse
        +getUploadStatus(int): JsonResponse
        +downloadTemplate(): Response
    }
    class UserFeaturePermissionService {
        +grantPermission(array): UserFeaturePermission
        +revokePermission(int): bool
        +checkPermission(int, int, int): bool
        +getManagedUsers(int, int): Collection
    }
    class PocketExpenseService {
        +createExpense(array): PocketExpense
        +updateExpense(int, array): PocketExpense
        +deleteExpense(int): bool
        +getUserExpenses(int, int): Collection
        +approveExpense(int, int): PocketExpense
    }
    class PocketExpenseCSVValidator {
        +validate(string, int, int, int): array
        -validateHeaders(array): bool
        -validateRow(array, int): array
        -preloadReferenceData(): void
    }
    class FXConversionService {
        +getWalletBaseCurrency(int): array
        +getFXRate(string, string, string): float
        +convertAmount(float, float, float): float
        +calculateWithCommission(float, float): float
    }
    class ProcessExpenseUpload {
        +handle(): void
        -syncExpensesBatch(Collection): void
        -updateUploadStatus(string): void
    }
    class UserFeaturePermissionPolicy {
        +viewAny(User): bool
        +view(User, UserFeaturePermission): bool
        +create(User): bool
        +update(User, UserFeaturePermission): bool
        +delete(User, UserFeaturePermission): bool
    }
    class PocketExpensePolicy {
        +viewAny(User): bool
        +view(User, PocketExpense): bool
        +create(User): bool
        +update(User, PocketExpense): bool
        +delete(User, PocketExpense): bool
        +approve(User, PocketExpense): bool
    }
    class PocketExpenseUploadPolicy {
        +upload(User, int): bool
        +viewUpload(User, PocketExpenseFileUpload): bool
    }
    UserFeaturePermission ||--o{ PocketExpense : manages
    PocketExpense ||--o{ PocketExpenseMetadata : has
    OptPocketExpenseType ||--o{ PocketExpense : categorizes
    PocketExpenseSourceClientConfig ||--o{ PocketExpenseMetadata : configures
    PocketExpenseFileUpload ||--o{ PocketExpenseUploadsData : contains
    UserFeaturePermissionController --> UserFeaturePermissionService : uses
    PocketExpenseController --> PocketExpenseService : uses
    PocketExpenseController --> FXConversionService : uses
    PocketExpenseUploadController --> PocketExpenseCSVValidator : uses
    ProcessExpenseUpload --> PocketExpenseService : uses
