classDiagram
    class UserFeaturePermission {
        +id: bigint
        +user_id: bigint
        +client_id: bigint
        +feature_id: bigint
        +grantor_id: bigint
        +manager_user_id: bigint
        +is_enabled: boolean
        +created_at: timestamp
        +updated_at: timestamp
        +user() BelongsTo
        +client() BelongsTo
        +feature() BelongsTo
        +grantor() BelongsTo
        +manager() BelongsTo
    }
    class OptPocketExpenseType {
        +id: int
        +option: string
        +amount_sign: enum
        +expenses() HasMany
    }
    class PocketExpenseSourceClientConfig {
        +id: int
        +uuid: string
        +client_id: int
        +name: string
        +is_default: boolean
        +deleted: boolean
        +delete_time: datetime
        +create_time: datetime
        +update_time: datetime
        +client() BelongsTo
        +metadata() HasMany
    }
    class PocketExpense {
        +id: int
        +uuid: string
        +user_id: int
        +client_id: int
        +date: date
        +merchant_name: string
        +merchant_description: string
        +expense_type: int
        +currency: string
        +amount: decimal
        +merchant_address: string
        +vat_amount: decimal
        +notes: text
        +status: enum
        +created_by_user_id: int
        +updated_by_user_id: int
        +approved_by_user_id: int
        +create_time: datetime
        +update_time: datetime
        +deleted: boolean
        +delete_time: datetime
        +user() BelongsTo
        +client() BelongsTo
        +expenseType() BelongsTo
        +metadata() HasMany
        +createdBy() BelongsTo
        +updatedBy() BelongsTo
        +approvedBy() BelongsTo
    }
    class PocketExpenseMetadata {
        +id: int
        +pocket_expense_id: int
        +metadata_type: enum
        +transaction_category_id: int
        +tracking_code_id: int
        +project_id: int
        +file_store_id: int
        +expense_source_id: int
        +additional_field_id: int
        +user_id: int
        +details_json: json
        +create_time: datetime
        +update_time: datetime
        +deleted: boolean
        +delete_time: datetime
        +pocketExpense() BelongsTo
        +transactionCategory() BelongsTo
        +trackingCode() BelongsTo
        +project() BelongsTo
        +fileStore() BelongsTo
        +expenseSource() BelongsTo
        +additionalField() BelongsTo
        +user() BelongsTo
    }
    class PocketExpenseFileUpload {
        +id: bigint
        +uuid: string
        +user_id: bigint
        +client_id: bigint
        +created_by_user_id: bigint
        +file_name: string
        +file_path: string
        +total_records: int
        +valid_records: int
        +validation_errors: json
        +status: enum
        +uploaded_at: timestamp
        +validated_at: timestamp
        +processed_at: timestamp
        +created_at: timestamp
        +updated_at: timestamp
        +deleted_at: timestamp
        +user() BelongsTo
        +client() BelongsTo
        +createdBy() BelongsTo
        +uploadsData() HasMany
